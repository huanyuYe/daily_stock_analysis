[Unit]
Description=Generate %i cross-market theme report and push it to QQ group
After=network-online.target
Wants=network-online.target
ConditionPathExists=/data/service/daily-stock-analysis/.env
ConditionPathExists=/home/ubuntu/.hermes/.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/data/service/daily-stock-analysis
Environment=HOME=/root
EnvironmentFile=/data/service/daily-stock-analysis/.env
EnvironmentFile=/home/ubuntu/.hermes/.env
EnvironmentFile=/data/service/daily-stock-analysis/.qqbot-bridge.env
ExecStart=/usr/bin/flock -w 1200 /run/lock/daily-stock-analysis-qqbot-active.lock /data/service/daily-stock-analysis/venv/bin/python scripts/run_cross_market_theme_report.py --phase %i --target-duration 1200
TimeoutStartSec=45m
Nice=10
UMask=0077

[Install]
WantedBy=multi-user.target
